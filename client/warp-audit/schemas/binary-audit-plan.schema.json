{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "faithro:warp-audit/binary-audit-plan",
  "title": "WARP binary offline audit plan (template)",
  "description": "Template do plano da auditoria binaria offline do nucleo prebuilt do WARP (ETAPA 2P-E-B-PREBUILT). Documental: nenhuma autorizacao operacional; flags operacionais const:false; apenas plan_creation_authorized/plan_created podem ser true.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "project", "stage", "record_type", "status",
    "source_decision_record", "upstream_project", "upstream_commit_pinned",
    "purpose", "non_authorization_notice", "non_authorization_chain",
    "principles", "states", "gates", "stop_criteria", "evidence_requirements",
    "blocked_patches", "reviewed_only_candidates", "authorizations"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "project": { "type": "string", "const": "WARP" },
    "stage": { "type": "string", "const": "2P-E-B-PREBUILT" },
    "record_type": { "type": "string", "const": "binary-audit-plan-template" },
    "status": { "type": "string", "const": "PLANNED_NOT_AUTHORIZED" },
    "source_decision_record": { "type": "string", "minLength": 1 },
    "upstream_project": { "type": "string", "const": "WARP" },
    "upstream_commit_pinned": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "purpose": { "type": "string", "minLength": 1 },
    "non_authorization_notice": { "type": "string", "minLength": 1 },
    "non_authorization_chain": {
      "type": "array",
      "minItems": 10,
      "items": { "type": "string", "minLength": 1 }
    },
    "principles": {
      "type": "array",
      "minItems": 15,
      "items": { "type": "string", "minLength": 1 }
    },
    "states": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "string",
        "enum": [
          "PLANNED_NOT_AUTHORIZED", "WAITING_HUMAN_DECISION",
          "AUTHORIZED_FOR_SINGLE_GATE", "IN_PROGRESS", "EVIDENCE_COLLECTED",
          "GATE_PASSED", "GATE_FAILED", "STOPPED", "SUPERSEDED"
        ]
      }
    },
    "gates": {
      "type": "array",
      "minItems": 17,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate_id", "gate_name", "objective", "planned_actions",
          "does_not_materialize_binary", "required_evidence",
          "human_decision_required", "exit_options", "does_not_authorize",
          "must_remain_false"
        ],
        "properties": {
          "gate_id": { "type": "integer", "minimum": 0 },
          "gate_name": { "type": "string", "minLength": 1 },
          "objective": { "type": "string", "minLength": 1 },
          "planned_actions": {
            "type": "array", "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "does_not_materialize_binary": { "type": "boolean", "const": true },
          "does_not_create_sandbox": { "type": "boolean", "const": true },
          "required_evidence": {
            "type": "array", "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "human_decision_required": { "type": "boolean", "const": true },
          "exit_options": {
            "type": "array", "minItems": 2,
            "items": { "type": "string", "minLength": 1 }
          },
          "does_not_authorize": {
            "type": "array", "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "must_remain_false": {
            "type": "array", "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "blocked_patches": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "reviewed_only_candidates": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "notes": { "type": "string", "minLength": 1 }
        }
      }
    },
    "stop_criteria": {
      "type": "array",
      "minItems": 10,
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields", "note"],
      "properties": {
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "blocked_patches": {
      "type": "array",
      "minItems": 4,
      "items": { "type": "string", "minLength": 1 }
    },
    "reviewed_only_candidates": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "minLength": 1 }
    },
    "authorizations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_creation_authorized", "plan_created",
        "provenance_reconfirmation_authorized", "materialization_authorized",
        "hashing_authorized", "static_inspection_authorized",
        "local_security_scan_authorized", "external_reputation_upload_authorized",
        "sandbox_creation_authorized", "execution_without_client_authorized",
        "client_copy_provision_authorized", "execution_with_client_copy_authorized",
        "patch_review_authorized", "patch_application_authorized",
        "client_preparation_authorized", "vps_access_authorized",
        "test_account_authorized", "first_login_authorized", "distribution_authorized"
      ],
      "properties": {
        "plan_creation_authorized": { "type": "boolean", "const": true },
        "plan_created": { "type": "boolean", "const": true },
        "provenance_reconfirmation_authorized": { "type": "boolean", "const": false },
        "materialization_authorized": { "type": "boolean", "const": false },
        "hashing_authorized": { "type": "boolean", "const": false },
        "static_inspection_authorized": { "type": "boolean", "const": false },
        "local_security_scan_authorized": { "type": "boolean", "const": false },
        "external_reputation_upload_authorized": { "type": "boolean", "const": false },
        "sandbox_creation_authorized": { "type": "boolean", "const": false },
        "execution_without_client_authorized": { "type": "boolean", "const": false },
        "client_copy_provision_authorized": { "type": "boolean", "const": false },
        "execution_with_client_copy_authorized": { "type": "boolean", "const": false },
        "patch_review_authorized": { "type": "boolean", "const": false },
        "patch_application_authorized": { "type": "boolean", "const": false },
        "client_preparation_authorized": { "type": "boolean", "const": false },
        "vps_access_authorized": { "type": "boolean", "const": false },
        "test_account_authorized": { "type": "boolean", "const": false },
        "first_login_authorized": { "type": "boolean", "const": false },
        "distribution_authorized": { "type": "boolean", "const": false }
      }
    }
  }
}
