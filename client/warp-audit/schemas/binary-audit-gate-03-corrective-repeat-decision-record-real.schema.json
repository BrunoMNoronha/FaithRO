{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "faithro:warp-audit/binary-audit-gate-03-corrective-repeat-decision-record-real",
  "title": "WARP binary audit GATE 3 corrective-repeat human decision record (real, future)",
  "description": "CONVENCAO (2P-E-C3-R2) para a FUTURA decisao humana da repeticao corretiva do GATE 3. NAO deve existir registro real nesta etapa (nenhuma autorizacao humana ainda foi dada). Quando criado, autoriza EXATAMENTE UMA repeticao: rematerializar o mesmo blob fixado e reinspecionar identidade/assinatura com o inspetor PE REVISADO e VERSIONADO. Referencia a decisao original do GATE 3, a evidencia original invalidada, a revisao R1, o commit exato e os Git blob OIDs do parser e dos testes, e o blob imutavel do WARP. gate_4_authorized const:false; sem autorizacao transitiva.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "project", "stage", "record_type", "status", "note",
    "original_decision_ref", "original_invalidated_evidence_ref", "r1_review_ref",
    "reviewed_parser_ref", "reviewed_parser_test_ref", "integration_ref",
    "reviewed_parser_commit", "reviewed_parser_git_blob_oid",
    "reviewed_parser_test_git_blob_oid", "gate", "decider", "role", "authority",
    "channel", "date", "decision", "justification", "authorized_scope",
    "materialization_scope", "repeat_scope", "precondition", "allowed_methods",
    "prohibited_actions", "conditions", "authorizations", "execution_state",
    "rollback", "notes"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "project": { "type": "string", "const": "WARP" },
    "stage": { "type": "string", "const": "2P-E-C3-REPEAT" },
    "record_type": { "type": "string", "const": "binary-audit-gate-03-corrective-repeat-human-decision-real" },
    "status": { "type": "string", "const": "AUTHORIZED_FOR_SINGLE_GATE" },
    "note": { "type": "string", "minLength": 1 },
    "original_decision_ref": { "type": "object", "additionalProperties": false, "required": ["path"], "properties": { "path": { "type": "string", "minLength": 1 } } },
    "original_invalidated_evidence_ref": { "type": "object", "additionalProperties": false, "required": ["path"], "properties": { "path": { "type": "string", "minLength": 1 } } },
    "r1_review_ref": { "type": "object", "additionalProperties": false, "required": ["path"], "properties": { "path": { "type": "string", "minLength": 1 } } },
    "reviewed_parser_ref": { "type": "object", "additionalProperties": false, "required": ["path"], "properties": { "path": { "type": "string", "const": "scripts/inspect-warp-pe-identity.py" } } },
    "reviewed_parser_test_ref": { "type": "object", "additionalProperties": false, "required": ["path"], "properties": { "path": { "type": "string", "const": "scripts/test-warp-pe-identity.py" } } },
    "integration_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pr", "squash_commit", "base_branch"],
      "properties": {
        "pr": { "type": "integer", "const": 50 },
        "squash_commit": { "type": "string", "const": "6ab37b2a7ae65fd6b4fdf184759b345cf9ce4bd6" },
        "base_branch": { "type": "string", "const": "dev" }
      }
    },
    "reviewed_parser_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "reviewed_parser_git_blob_oid": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "reviewed_parser_test_git_blob_oid": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "integer", "const": 3 },
        "name": { "type": "string", "const": "IDENTITY_AND_SIGNATURE" }
      }
    },
    "decider": { "type": "string", "minLength": 2 },
    "role": { "type": "string", "minLength": 2 },
    "authority": { "type": "string", "minLength": 2 },
    "channel": { "type": "string", "minLength": 2 },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "decision": { "type": "string", "const": "AUTHORIZE_CORRECTIVE_REPEAT_GATE_3" },
    "justification": { "type": "string", "minLength": 1 },
    "authorized_scope": { "type": "string", "minLength": 1 },
    "materialization_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_full_name", "repository_visibility", "expected_branch",
        "commit_oid", "tree_oid", "artifact_path", "artifact_blob_oid",
        "artifact_blob_oid_algorithm", "artifact_blob_size", "max_files", "network_scope"
      ],
      "properties": {
        "repository_full_name": { "type": "string", "const": "Neo-Mind/WARP" },
        "repository_visibility": { "type": "string", "const": "PUBLIC" },
        "expected_branch": { "type": "string", "const": "rock_win32" },
        "commit_oid": { "type": "string", "const": "9b1173e9e4e135c68e150704f01186ab5e763acd" },
        "tree_oid": { "type": "string", "const": "1aebae06d5c71a145afc35cc72fcf5c210a08758" },
        "artifact_path": { "type": "string", "const": "win32/WARP.exe" },
        "artifact_blob_oid": { "type": "string", "const": "c853da42d18dfe090b4e941b435d989311faf3dc" },
        "artifact_blob_oid_algorithm": { "type": "string", "const": "GIT_OBJECT_ID" },
        "artifact_blob_size": { "type": "integer", "const": 1137152 },
        "max_files": { "type": "integer", "const": 1 },
        "network_scope": { "type": "string", "const": "GITHUB_OFFICIAL_ONLY" }
      }
    },
    "repeat_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exactly_one_repeat", "repeat_index"],
      "properties": {
        "exactly_one_repeat": { "type": "boolean", "const": true },
        "repeat_index": { "type": "integer", "const": 1 }
      }
    },
    "precondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_2_outcome", "original_evidence_invalidated"],
      "properties": {
        "gate_2_outcome": { "type": "string", "const": "COMPLETED_PASS" },
        "original_evidence_invalidated": { "type": "boolean", "const": true }
      }
    },
    "allowed_methods": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "prohibited_actions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "conditions": {
      "type": "array",
      "minItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["n", "text"],
        "properties": {
          "n": { "type": "integer", "minimum": 1 },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "authorizations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human_decision_required", "human_decision_received", "gate_selected",
        "gate_3_corrective_repeat_authorized", "temporary_materialization_authorized",
        "local_hashing_authorized", "static_identity_inspection_authorized",
        "authenticode_inspection_authorized", "gate_4_authorized",
        "execution_authorized", "dynamic_analysis_authorized",
        "external_reputation_upload_authorized", "network_validation_authorized",
        "sandbox_creation_authorized", "client_copy_provision_authorized",
        "client_modification_authorized", "patch_review_authorized",
        "patch_application_authorized", "client_preparation_authorized",
        "test_account_authorized", "first_login_authorized", "vps_access_authorized",
        "distribution_authorized", "second_repeat_authorized"
      ],
      "properties": {
        "human_decision_required": { "type": "boolean", "const": true },
        "human_decision_received": { "type": "boolean", "const": true },
        "gate_selected": { "type": "boolean", "const": true },
        "gate_3_corrective_repeat_authorized": { "type": "boolean", "const": true },
        "temporary_materialization_authorized": { "type": "boolean", "const": true },
        "local_hashing_authorized": { "type": "boolean", "const": true },
        "static_identity_inspection_authorized": { "type": "boolean", "const": true },
        "authenticode_inspection_authorized": { "type": "boolean", "const": true },
        "gate_4_authorized": { "type": "boolean", "const": false },
        "execution_authorized": { "type": "boolean", "const": false },
        "dynamic_analysis_authorized": { "type": "boolean", "const": false },
        "external_reputation_upload_authorized": { "type": "boolean", "const": false },
        "network_validation_authorized": { "type": "boolean", "const": false },
        "sandbox_creation_authorized": { "type": "boolean", "const": false },
        "client_copy_provision_authorized": { "type": "boolean", "const": false },
        "client_modification_authorized": { "type": "boolean", "const": false },
        "patch_review_authorized": { "type": "boolean", "const": false },
        "patch_application_authorized": { "type": "boolean", "const": false },
        "client_preparation_authorized": { "type": "boolean", "const": false },
        "test_account_authorized": { "type": "boolean", "const": false },
        "first_login_authorized": { "type": "boolean", "const": false },
        "vps_access_authorized": { "type": "boolean", "const": false },
        "distribution_authorized": { "type": "boolean", "const": false },
        "second_repeat_authorized": { "type": "boolean", "const": false }
      }
    },
    "execution_state": { "type": "string", "const": "AUTHORIZED_NOT_STARTED" },
    "rollback": { "type": "string", "minLength": 1 },
    "notes": { "type": "string", "minLength": 1 }
  }
}
