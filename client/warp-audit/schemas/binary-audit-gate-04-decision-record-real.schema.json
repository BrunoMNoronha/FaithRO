{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "faithro:warp-audit/binary-audit-gate-04-decision-record-real",
  "title": "WARP GATE 4 static PE inventory — human decision record (real, future)",
  "description": "CONVENCAO (2P-E-C4-PREP) para a FUTURA decisao humana que podera autorizar a execucao do GATE 4 (inventario PE estatico offline). Schema FECHADO. NENHUM registro real existe nesta etapa: a preparacao NAO cria decisao. A futura decisao referenciara o squash integrado desta preparacao e os Git blob OIDs exatos do analisador e dos testes revisados. gate_5_authorized const:false. Decisao AUTHORIZE_GATE_4_EXECUTION; escopo fechado ao blob fixado canonico; sem autorizacao transitiva.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "project", "stage", "record_type", "status", "gate", "decision",
    "execution_state", "decider", "role", "authority", "channel", "date",
    "justification", "conditions", "authorizations", "materialization_scope",
    "precondition", "integration_ref", "plan_ref", "source_decision_ref",
    "prior_gate_decision_ref", "gate_3_evidence_ref", "reviewed_analyzer_ref",
    "reviewed_analyzer_commit", "reviewed_analyzer_git_blob_oid",
    "reviewed_analyzer_test_ref", "reviewed_analyzer_test_git_blob_oid",
    "rollback", "notes"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "project": { "type": "string", "const": "WARP" },
    "stage": { "type": "string", "const": "2P-E-C4" },
    "record_type": { "type": "string", "const": "binary-audit-gate-04-decision-record-real" },
    "status": { "type": "string", "const": "AUTHORIZED_FOR_SINGLE_GATE" },
    "gate": {
      "type": "object", "additionalProperties": false, "required": ["id", "name"],
      "properties": { "id": { "type": "integer", "const": 4 }, "name": { "type": "string", "const": "STATIC_PE_INVENTORY" } }
    },
    "decision": { "type": "string", "const": "AUTHORIZE_GATE_4_EXECUTION" },
    "execution_state": { "type": "string", "const": "AUTHORIZED_NOT_STARTED" },
    "decider": { "type": "string", "minLength": 2 },
    "role": { "type": "string", "minLength": 2 },
    "authority": { "type": "string", "minLength": 2 },
    "channel": { "type": "string", "minLength": 2 },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "justification": { "type": "string", "minLength": 1 },
    "conditions": {
      "type": "array", "minItems": 15,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["n", "text"],
        "properties": { "n": { "type": "integer", "minimum": 1 }, "text": { "type": "string", "minLength": 1 } }
      }
    },
    "authorizations": {
      "type": "object", "additionalProperties": false,
      "required": [
        "human_decision_required", "human_decision_received", "gate_selected",
        "gate_3_completed", "temporary_materialization_authorized",
        "local_hashing_authorized", "static_inventory_authorized",
        "gate_4_authorized", "gate_4_execution_authorized", "gate_5_authorized",
        "dynamic_analysis_authorized", "emulation_authorized", "unpacking_authorized",
        "execution_authorized", "external_reputation_upload_authorized",
        "network_validation_authorized", "sandbox_creation_authorized",
        "client_copy_provision_authorized", "client_modification_authorized",
        "patch_review_authorized", "patch_application_authorized",
        "client_preparation_authorized", "test_account_authorized",
        "first_login_authorized", "vps_access_authorized", "distribution_authorized"
      ],
      "properties": {
        "human_decision_required": { "type": "boolean", "const": true },
        "human_decision_received": { "type": "boolean", "const": true },
        "gate_selected": { "type": "boolean", "const": true },
        "gate_3_completed": { "type": "boolean", "const": true },
        "temporary_materialization_authorized": { "type": "boolean", "const": true },
        "local_hashing_authorized": { "type": "boolean", "const": true },
        "static_inventory_authorized": { "type": "boolean", "const": true },
        "gate_4_authorized": { "type": "boolean", "const": true },
        "gate_4_execution_authorized": { "type": "boolean", "const": true },
        "gate_5_authorized": { "type": "boolean", "const": false },
        "dynamic_analysis_authorized": { "type": "boolean", "const": false },
        "emulation_authorized": { "type": "boolean", "const": false },
        "unpacking_authorized": { "type": "boolean", "const": false },
        "execution_authorized": { "type": "boolean", "const": false },
        "external_reputation_upload_authorized": { "type": "boolean", "const": false },
        "network_validation_authorized": { "type": "boolean", "const": false },
        "sandbox_creation_authorized": { "type": "boolean", "const": false },
        "client_copy_provision_authorized": { "type": "boolean", "const": false },
        "client_modification_authorized": { "type": "boolean", "const": false },
        "patch_review_authorized": { "type": "boolean", "const": false },
        "patch_application_authorized": { "type": "boolean", "const": false },
        "client_preparation_authorized": { "type": "boolean", "const": false },
        "test_account_authorized": { "type": "boolean", "const": false },
        "first_login_authorized": { "type": "boolean", "const": false },
        "vps_access_authorized": { "type": "boolean", "const": false },
        "distribution_authorized": { "type": "boolean", "const": false }
      }
    },
    "materialization_scope": {
      "type": "object", "additionalProperties": false,
      "required": ["repository_full_name", "commit_oid", "tree_oid", "artifact_path", "artifact_blob_oid", "artifact_blob_oid_algorithm", "artifact_blob_size", "max_files", "network_scope"],
      "properties": {
        "repository_full_name": { "type": "string", "const": "Neo-Mind/WARP" },
        "commit_oid": { "type": "string", "const": "9b1173e9e4e135c68e150704f01186ab5e763acd" },
        "tree_oid": { "type": "string", "const": "1aebae06d5c71a145afc35cc72fcf5c210a08758" },
        "artifact_path": { "type": "string", "const": "win32/WARP.exe" },
        "artifact_blob_oid": { "type": "string", "const": "c853da42d18dfe090b4e941b435d989311faf3dc" },
        "artifact_blob_oid_algorithm": { "type": "string", "const": "GIT_OBJECT_ID" },
        "artifact_blob_size": { "type": "integer", "const": 1137152 },
        "max_files": { "type": "integer", "const": 1 },
        "network_scope": { "type": "string", "const": "GITHUB_OFFICIAL_ONLY" }
      }
    },
    "precondition": {
      "type": "object", "additionalProperties": false,
      "required": ["gate_3_completed", "gate_3_outcome"],
      "properties": {
        "gate_3_completed": { "type": "boolean", "const": true },
        "gate_3_outcome": { "type": "string", "const": "COMPLETED_PASS" }
      }
    },
    "integration_ref": {
      "type": "object", "additionalProperties": false, "required": ["pr", "squash_commit", "base_branch"],
      "properties": {
        "pr": { "type": "integer", "minimum": 1 },
        "squash_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "base_branch": { "type": "string", "const": "dev" }
      }
    },
    "plan_ref": { "type": "object", "additionalProperties": false, "required": ["path"], "properties": { "path": { "type": "string", "minLength": 1 } } },
    "source_decision_ref": { "type": "object", "additionalProperties": false, "required": ["path"], "properties": { "path": { "type": "string", "minLength": 1 } } },
    "prior_gate_decision_ref": { "type": "object", "additionalProperties": false, "required": ["path"], "properties": { "path": { "type": "string", "minLength": 1 } } },
    "gate_3_evidence_ref": { "type": "object", "additionalProperties": false, "required": ["path"], "properties": { "path": { "type": "string", "minLength": 1 } } },
    "reviewed_analyzer_ref": { "type": "object", "additionalProperties": false, "required": ["path"], "properties": { "path": { "type": "string", "const": "scripts/inspect-warp-pe-static.py" } } },
    "reviewed_analyzer_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "reviewed_analyzer_git_blob_oid": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "reviewed_analyzer_test_ref": { "type": "object", "additionalProperties": false, "required": ["path"], "properties": { "path": { "type": "string", "const": "scripts/test-warp-pe-static.py" } } },
    "reviewed_analyzer_test_git_blob_oid": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "rollback": { "type": "string", "minLength": 1 },
    "notes": { "type": "string", "minLength": 1 }
  }
}
