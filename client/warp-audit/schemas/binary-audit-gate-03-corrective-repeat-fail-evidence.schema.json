{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "faithro:warp-audit/binary-audit-gate-03-corrective-repeat-fail-evidence",
  "title": "WARP GATE 3 corrective-repeat evidence — COMPLETED_FAIL (real, future)",
  "description": "CONVENCAO (2P-E-C3-R3; ligacao/estados fechados em 2P-E-C3-R4.1) para a FUTURA evidencia da repeticao corretiva do GATE 3 no caminho COMPLETED_FAIL (ex.: tamanho/Git OID/SHA-256 divergentes, parser retornou erro, estrutura PE/Certificate Table inconsistente, falha de limpeza). NAO exige identity_matches_gate_2=true nem cabecalhos completos; exige um motivo de falha. parser_execution tem tres estados fechados validos: PRE_PARSER_FAIL(false/false/false), PARSER_ERROR_WITHOUT_OUTPUT(true/false/false) e POST_OUTPUT_FAIL(true/true/true); no POST_OUTPUT_FAIL a saida e presa por SHA-256 dos bytes reais e por igualdade exata do reviewed_parser_output_ref.path com o caminho canonico do unico arquivo de saida. Nenhum registro real nesta etapa. gate_4_authorized const:false; sem execucao do binario.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "project", "stage", "record_type", "status", "outcome", "gate",
    "original_invalidated_evidence_ref", "corrective_repeat_decision_ref",
    "reviewed_parser_ref", "reviewed_parser_commit", "reviewed_parser_git_blob_oid",
    "reviewed_parser_test_ref", "reviewed_parser_test_git_blob_oid",
    "integration_ref", "parser_execution", "failure", "reviewed_parser",
    "security_assertions", "findings", "limitations", "rollback", "notes"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "project": { "type": "string", "const": "WARP" },
    "stage": { "type": "string", "const": "2P-E-C3-REPEAT" },
    "record_type": { "type": "string", "const": "binary-audit-gate-03-corrective-repeat-fail-evidence-real" },
    "status": { "type": "string", "const": "COMPLETED_FAIL" },
    "outcome": { "type": "string", "const": "COMPLETED_FAIL" },
    "gate": {
      "type": "object", "additionalProperties": false, "required": ["id", "name"],
      "properties": { "id": { "type": "integer", "const": 3 }, "name": { "type": "string", "const": "IDENTITY_AND_SIGNATURE" } }
    },
    "original_invalidated_evidence_ref": { "type": "object", "additionalProperties": false, "required": ["path"], "properties": { "path": { "type": "string", "const": "client/warp-audit/evidence/binary-audit-gate-03-identity-signature-evidence-2026-08-03.json" } } },
    "corrective_repeat_decision_ref": { "type": "object", "additionalProperties": false, "required": ["path"], "properties": { "path": { "type": "string", "minLength": 1 } } },
    "reviewed_parser_ref": { "type": "object", "additionalProperties": false, "required": ["path"], "properties": { "path": { "type": "string", "const": "scripts/inspect-warp-pe-identity.py" } } },
    "reviewed_parser_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "reviewed_parser_git_blob_oid": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "reviewed_parser_test_ref": { "type": "object", "additionalProperties": false, "required": ["path"], "properties": { "path": { "type": "string", "const": "scripts/test-warp-pe-identity.py" } } },
    "reviewed_parser_test_git_blob_oid": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "reviewed_parser_output_ref": { "type": "object", "additionalProperties": false, "required": ["path"], "properties": { "path": { "type": "string", "minLength": 1 } } },
    "reviewed_parser_output_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "integration_ref": {
      "type": "object", "additionalProperties": false, "required": ["pr", "squash_commit", "base_branch"],
      "properties": { "pr": { "type": "integer", "const": 50 }, "squash_commit": { "type": "string", "const": "6ab37b2a7ae65fd6b4fdf184759b345cf9ce4bd6" }, "base_branch": { "type": "string", "const": "dev" } }
    },
    "parser_execution": {
      "type": "object", "additionalProperties": false,
      "description": "Tri-flag do parser. O mini-validador nao implementa if/then/else, entao as relacoes condicionais sao aplicadas em Python (validate_parser_execution_state, 2P-E-C3-R4.1). Estados FECHADOS validos no COMPLETED_FAIL: PRE_PARSER_FAIL = false/false/false (falha antes de invocar o parser); PARSER_ERROR_WITHOUT_OUTPUT = true/false/false (parser retornou erro sem JSON valido); POST_OUTPUT_FAIL = true/true/true (saida valida produzida, falha posterior, com referencia exata e SHA-256 dos bytes reais). Qualquer outra combinacao e reprovada.",
      "required": ["parser_invoked", "parser_completed", "parser_output_produced"],
      "properties": {
        "parser_invoked": { "type": "boolean" },
        "parser_completed": { "type": "boolean" },
        "parser_output_produced": { "type": "boolean" }
      }
    },
    "failure": {
      "type": "object", "additionalProperties": false,
      "required": ["category", "reason", "identity_matches_gate_2", "cleanup_attempted"],
      "properties": {
        "category": { "type": "string", "enum": ["SIZE_MISMATCH", "GIT_OID_MISMATCH", "SHA256_MISMATCH", "PARSER_ERROR", "PE_STRUCTURE_INCONSISTENT", "CERTIFICATE_TABLE_INCONSISTENT", "CLEANUP_FAILURE"] },
        "reason": { "type": "string", "minLength": 1 },
        "identity_matches_gate_2": { "type": "boolean" },
        "cleanup_attempted": { "type": "boolean", "const": true }
      }
    },
    "reviewed_parser": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "git_blob_oid", "executes_or_loads_pe", "run_on_warp_exe"],
      "properties": {
        "path": { "type": "string", "const": "scripts/inspect-warp-pe-identity.py" },
        "git_blob_oid": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "executes_or_loads_pe": { "type": "boolean", "const": false },
        "run_on_warp_exe": { "type": "boolean" }
      }
    },
    "security_assertions": {
      "type": "object", "additionalProperties": false,
      "required": ["no_execution_performed", "no_gate4_inspection_performed", "no_ragexe_access", "no_vps_access", "binary_versioned", "gate_4_authorized"],
      "properties": {
        "no_execution_performed": { "type": "boolean", "const": true },
        "no_gate4_inspection_performed": { "type": "boolean", "const": true },
        "no_ragexe_access": { "type": "boolean", "const": true },
        "no_vps_access": { "type": "boolean", "const": true },
        "binary_versioned": { "type": "boolean", "const": false },
        "gate_4_authorized": { "type": "boolean", "const": false }
      }
    },
    "findings": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "rollback": { "type": "string", "minLength": 1 },
    "notes": { "type": "string", "minLength": 1 }
  }
}
