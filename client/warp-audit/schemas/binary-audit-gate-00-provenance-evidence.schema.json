{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "faithro:warp-audit/binary-audit-gate-00-provenance-evidence",
  "title": "WARP binary audit GATE 0 provenance evidence (real)",
  "description": "Evidencia real da execucao do GATE 0 (reconfirmacao de proveniencia por metadados oficiais). Somente metadados; nenhum conteudo de blob; binario nao materializado; git_blob_oid e identificador Git, nao SHA-256 local. A execucao do GATE 0 NAO autoriza o GATE 1 nem qualquer operacao.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "project", "stage", "record_type", "status", "gate",
    "authorization_ref", "plan_ref", "source_decision_ref", "execution",
    "authorization_snapshot", "upstream_expected", "upstream_observed",
    "commit_evidence", "tree_evidence", "artifact_evidence", "refs_evidence",
    "tags_evidence", "releases_evidence", "license_evidence", "consistency_matrix",
    "query_log", "limitations", "findings", "outcome", "authorizations",
    "security_assertions", "rollback", "notes"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "project": { "type": "string", "const": "WARP" },
    "stage": { "type": "string", "const": "2P-E-C0-B" },
    "record_type": { "type": "string", "const": "binary-audit-gate-00-provenance-evidence-real" },
    "status": { "type": "string", "enum": ["COMPLETED_PASS", "COMPLETED_INCONCLUSIVE", "STOPPED"] },
    "gate": {
      "type": "object", "additionalProperties": false, "required": ["id", "name"],
      "properties": {
        "id": { "type": "integer", "const": 0 },
        "name": { "type": "string", "const": "PROVENANCE_RECONFIRMATION" }
      }
    },
    "authorization_ref": {
      "type": "object", "additionalProperties": false, "required": ["path"],
      "properties": { "path": { "type": "string", "minLength": 1 } }
    },
    "plan_ref": {
      "type": "object", "additionalProperties": false, "required": ["path"],
      "properties": { "path": { "type": "string", "minLength": 1 } }
    },
    "source_decision_ref": {
      "type": "object", "additionalProperties": false, "required": ["path"],
      "properties": { "path": { "type": "string", "minLength": 1 } }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["gate_0_started", "gate_0_completed", "execution_state", "started_at", "finished_at", "operator", "method", "network_scope"],
      "properties": {
        "gate_0_started": { "type": "boolean", "const": true },
        "gate_0_completed": { "type": "boolean" },
        "execution_state": { "type": "string", "enum": ["COMPLETED", "STOPPED"] },
        "started_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
        "finished_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
        "operator": { "type": "string", "minLength": 2 },
        "method": { "type": "string", "const": "METADATA_ONLY" },
        "network_scope": { "type": "string", "const": "GITHUB_OFFICIAL_ONLY" }
      }
    },
    "authorization_snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["decision", "provenance_reconfirmation_authorized", "gate_1_authorized"],
      "properties": {
        "decision": { "type": "string", "const": "APPROVE_GATE_0" },
        "provenance_reconfirmation_authorized": { "type": "boolean", "const": true },
        "gate_1_authorized": { "type": "boolean", "const": false }
      }
    },
    "upstream_expected": {
      "type": "object", "additionalProperties": false,
      "required": ["repository_full_name", "commit_oid", "artifact_path", "artifact_blob_oid", "artifact_blob_size", "expected_branch"],
      "properties": {
        "repository_full_name": { "type": "string", "minLength": 1 },
        "commit_oid": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "artifact_path": { "type": "string", "minLength": 1 },
        "artifact_blob_oid": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "artifact_blob_size": { "type": "integer", "minimum": 0 },
        "expected_branch": { "type": "string", "minLength": 1 }
      }
    },
    "upstream_observed": {
      "type": "object", "additionalProperties": false,
      "required": ["repository_full_name", "owner", "visibility", "is_fork", "parent", "is_archived", "default_branch", "created_at", "updated_at"],
      "properties": {
        "repository_full_name": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "visibility": { "type": "string", "minLength": 1 },
        "is_fork": { "type": "boolean" },
        "parent": { "type": "null" },
        "is_archived": { "type": "boolean" },
        "default_branch": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
        "updated_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" }
      }
    },
    "commit_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["expected_commit_oid", "observed_commit_oid", "object_type", "tree_oid", "parent_oids", "author_date", "committer_date", "commit_exists"],
      "properties": {
        "expected_commit_oid": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "observed_commit_oid": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "object_type": { "type": "string", "const": "commit" },
        "tree_oid": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "parent_oids": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f]{40}$" } },
        "author_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
        "committer_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
        "commit_exists": { "type": "boolean", "const": true }
      }
    },
    "tree_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["tree_oid", "tree_truncated", "artifact_path_expected", "artifact_path_found", "artifact_entry_type", "artifact_blob_oid", "artifact_blob_size", "matching_paths_count"],
      "properties": {
        "tree_oid": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "tree_truncated": { "type": "boolean" },
        "artifact_path_expected": { "type": "string", "minLength": 1 },
        "artifact_path_found": { "type": "string", "minLength": 1 },
        "artifact_entry_type": { "type": "string", "const": "blob" },
        "artifact_blob_oid": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "artifact_blob_size": { "type": "integer", "minimum": 0 },
        "matching_paths_count": { "type": "integer", "minimum": 0 }
      }
    },
    "artifact_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "object_type", "git_blob_oid", "git_blob_oid_algorithm", "size_bytes_metadata", "binary_sha256", "binary_sha256_computed", "blob_content_accessed", "binary_materialized"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "object_type": { "type": "string", "const": "blob" },
        "git_blob_oid": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "git_blob_oid_algorithm": { "type": "string", "const": "GIT_OBJECT_ID" },
        "size_bytes_metadata": { "type": "integer", "minimum": 0 },
        "binary_sha256": { "type": "null" },
        "binary_sha256_computed": { "type": "boolean", "const": false },
        "blob_content_accessed": { "type": "boolean", "const": false },
        "binary_materialized": { "type": "boolean", "const": false }
      }
    },
    "refs_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["head_refs_count", "tag_refs_count", "direct_refs_pointing_to_commit", "direct_head_refs", "ancestry"],
      "properties": {
        "head_refs_count": { "type": "integer", "minimum": 0 },
        "tag_refs_count": { "type": "integer", "minimum": 0 },
        "direct_refs_pointing_to_commit": { "type": "integer", "minimum": 0 },
        "direct_head_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "ancestry": { "type": "string", "minLength": 1 }
      }
    },
    "tags_evidence": {
      "type": "object", "additionalProperties": false, "required": ["tags_observed"],
      "properties": { "tags_observed": { "type": "integer", "minimum": 0 } }
    },
    "releases_evidence": {
      "type": "object", "additionalProperties": false, "required": ["release_count", "releases"],
      "properties": {
        "release_count": { "type": "integer", "minimum": 0 },
        "releases": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "tag_name": { "type": "string" },
              "name": { "type": "string" },
              "is_draft": { "type": "boolean" },
              "is_prerelease": { "type": "boolean" },
              "published_at": { "type": "string" },
              "asset_count": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "license_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["license_name", "license_spdx_id", "license_metadata_present"],
      "properties": {
        "license_name": { "type": "string", "minLength": 1 },
        "license_spdx_id": { "type": "string", "minLength": 1 },
        "license_metadata_present": { "type": "boolean" }
      }
    },
    "consistency_matrix": {
      "type": "array", "minItems": 11,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["field", "expected", "observed", "result", "internal_source", "upstream_source", "note"],
        "properties": {
          "field": { "type": "string", "minLength": 1 },
          "expected": { "type": "string" },
          "observed": { "type": "string" },
          "result": { "type": "string", "enum": ["MATCH", "DIFF", "N/A"] },
          "internal_source": { "type": "string", "minLength": 1 },
          "upstream_source": { "type": "string", "minLength": 1 },
          "note": { "type": "string" }
        }
      }
    },
    "query_log": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["sequence", "timestamp", "method", "source", "endpoint_class", "selected_fields", "purpose", "result"],
        "properties": {
          "sequence": { "type": "integer", "minimum": 1 },
          "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
          "method": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "endpoint_class": {
            "type": "string",
            "enum": ["REPOSITORY_METADATA", "GIT_COMMIT_METADATA", "GIT_TREE_METADATA", "REF_METADATA", "TAG_METADATA", "RELEASE_METADATA", "LICENSE_METADATA"]
          },
          "selected_fields": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "purpose": { "type": "string", "minLength": 1 },
          "result": { "type": "string", "minLength": 1 }
        }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "findings": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "outcome": { "type": "string", "enum": ["COMPLETED_PASS", "COMPLETED_INCONCLUSIVE", "STOPPED"] },
    "authorizations": {
      "type": "object", "additionalProperties": false,
      "required": [
        "gate_1_authorized", "materialization_authorized", "hashing_authorized",
        "static_inspection_authorized", "local_security_scan_authorized",
        "external_reputation_upload_authorized", "sandbox_creation_authorized",
        "execution_without_client_authorized", "client_copy_provision_authorized",
        "execution_with_client_copy_authorized", "patch_review_authorized",
        "patch_application_authorized", "client_preparation_authorized",
        "vps_access_authorized", "test_account_authorized", "first_login_authorized",
        "distribution_authorized"
      ],
      "properties": {
        "gate_1_authorized": { "type": "boolean", "const": false },
        "materialization_authorized": { "type": "boolean", "const": false },
        "hashing_authorized": { "type": "boolean", "const": false },
        "static_inspection_authorized": { "type": "boolean", "const": false },
        "local_security_scan_authorized": { "type": "boolean", "const": false },
        "external_reputation_upload_authorized": { "type": "boolean", "const": false },
        "sandbox_creation_authorized": { "type": "boolean", "const": false },
        "execution_without_client_authorized": { "type": "boolean", "const": false },
        "client_copy_provision_authorized": { "type": "boolean", "const": false },
        "execution_with_client_copy_authorized": { "type": "boolean", "const": false },
        "patch_review_authorized": { "type": "boolean", "const": false },
        "patch_application_authorized": { "type": "boolean", "const": false },
        "client_preparation_authorized": { "type": "boolean", "const": false },
        "vps_access_authorized": { "type": "boolean", "const": false },
        "test_account_authorized": { "type": "boolean", "const": false },
        "first_login_authorized": { "type": "boolean", "const": false },
        "distribution_authorized": { "type": "boolean", "const": false }
      }
    },
    "security_assertions": {
      "type": "object", "additionalProperties": false,
      "required": [
        "blob_content_accessed", "binary_materialized", "binary_sha256_computed",
        "binary_sha256", "no_download_performed", "no_clone_or_fetch_upstream",
        "no_archive_or_release_asset", "no_direct_binary_url_followed",
        "no_blob_endpoint_used", "no_contents_endpoint_used",
        "raw_responses_versioned", "network_scope"
      ],
      "properties": {
        "blob_content_accessed": { "type": "boolean", "const": false },
        "binary_materialized": { "type": "boolean", "const": false },
        "binary_sha256_computed": { "type": "boolean", "const": false },
        "binary_sha256": { "type": "null" },
        "no_download_performed": { "type": "boolean", "const": true },
        "no_clone_or_fetch_upstream": { "type": "boolean", "const": true },
        "no_archive_or_release_asset": { "type": "boolean", "const": true },
        "no_direct_binary_url_followed": { "type": "boolean", "const": true },
        "no_blob_endpoint_used": { "type": "boolean", "const": true },
        "no_contents_endpoint_used": { "type": "boolean", "const": true },
        "raw_responses_versioned": { "type": "boolean", "const": false },
        "network_scope": { "type": "string", "const": "GITHUB_OFFICIAL_ONLY" }
      }
    },
    "rollback": { "type": "string", "minLength": 1 },
    "notes": { "type": "string", "minLength": 1 }
  }
}
