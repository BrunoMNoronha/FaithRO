{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "faithro:warp-audit/binary-audit-gate-00-decision-record-real",
  "title": "WARP binary audit GATE 0 human decision record (real, filled)",
  "description": "Registro REAL da autorizacao humana EXCLUSIVA do GATE 0 (reconfirmacao de proveniencia por metadados). Especifico do GATE 0: nao reutilizavel para autorizar outros gates. Autoriza somente o GATE 0; gate_0_started/gate_0_completed e todas as demais flags operacionais const:false; GATE 1 const:false.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "project", "stage", "record_type", "status", "note",
    "plan_ref", "source_decision_ref", "gate", "decider", "role", "authority",
    "channel", "date", "decision", "justification", "authorized_scope",
    "allowed_methods", "prohibited_actions", "conditions", "authorizations",
    "execution_state", "rollback", "notes"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "project": { "type": "string", "const": "WARP" },
    "stage": { "type": "string", "const": "2P-E-C0-A" },
    "record_type": { "type": "string", "const": "binary-audit-gate-00-human-decision-real" },
    "status": { "type": "string", "const": "AUTHORIZED_FOR_SINGLE_GATE" },
    "note": { "type": "string", "minLength": 1 },
    "plan_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": { "path": { "type": "string", "minLength": 1 } }
    },
    "source_decision_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": { "path": { "type": "string", "minLength": 1 } }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "integer", "const": 0 },
        "name": { "type": "string", "const": "PROVENANCE_RECONFIRMATION" }
      }
    },
    "decider": { "type": "string", "minLength": 2 },
    "role": { "type": "string", "minLength": 2 },
    "authority": { "type": "string", "minLength": 2 },
    "channel": { "type": "string", "minLength": 2 },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "decision": { "type": "string", "const": "APPROVE_GATE_0" },
    "justification": { "type": "string", "minLength": 1 },
    "authorized_scope": { "type": "string", "minLength": 1 },
    "allowed_methods": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "prohibited_actions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "conditions": {
      "type": "array",
      "minItems": 17,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["n", "text"],
        "properties": {
          "n": { "type": "integer", "minimum": 1 },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "authorizations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human_decision_required", "human_decision_received", "gate_selected",
        "provenance_reconfirmation_authorized", "gate_0_started", "gate_0_completed",
        "materialization_authorized", "hashing_authorized", "static_inspection_authorized",
        "local_security_scan_authorized", "external_reputation_upload_authorized",
        "sandbox_creation_authorized", "execution_without_client_authorized",
        "client_copy_provision_authorized", "execution_with_client_copy_authorized",
        "patch_review_authorized", "patch_application_authorized",
        "client_preparation_authorized", "vps_access_authorized",
        "test_account_authorized", "first_login_authorized", "distribution_authorized",
        "gate_1_authorized"
      ],
      "properties": {
        "human_decision_required": { "type": "boolean", "const": true },
        "human_decision_received": { "type": "boolean", "const": true },
        "gate_selected": { "type": "boolean", "const": true },
        "provenance_reconfirmation_authorized": { "type": "boolean", "const": true },
        "gate_0_started": { "type": "boolean", "const": false },
        "gate_0_completed": { "type": "boolean", "const": false },
        "materialization_authorized": { "type": "boolean", "const": false },
        "hashing_authorized": { "type": "boolean", "const": false },
        "static_inspection_authorized": { "type": "boolean", "const": false },
        "local_security_scan_authorized": { "type": "boolean", "const": false },
        "external_reputation_upload_authorized": { "type": "boolean", "const": false },
        "sandbox_creation_authorized": { "type": "boolean", "const": false },
        "execution_without_client_authorized": { "type": "boolean", "const": false },
        "client_copy_provision_authorized": { "type": "boolean", "const": false },
        "execution_with_client_copy_authorized": { "type": "boolean", "const": false },
        "patch_review_authorized": { "type": "boolean", "const": false },
        "patch_application_authorized": { "type": "boolean", "const": false },
        "client_preparation_authorized": { "type": "boolean", "const": false },
        "vps_access_authorized": { "type": "boolean", "const": false },
        "test_account_authorized": { "type": "boolean", "const": false },
        "first_login_authorized": { "type": "boolean", "const": false },
        "distribution_authorized": { "type": "boolean", "const": false },
        "gate_1_authorized": { "type": "boolean", "const": false }
      }
    },
    "execution_state": { "type": "string", "const": "AUTHORIZED_NOT_STARTED" },
    "rollback": { "type": "string", "minLength": 1 },
    "notes": { "type": "string", "minLength": 1 }
  }
}
