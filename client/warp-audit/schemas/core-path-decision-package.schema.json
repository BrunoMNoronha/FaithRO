{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "faithro:warp-audit/core-path-decision-package",
  "title": "WARP core-path decision package",
  "description": "Pacote de decisao humana sobre o caminho do nucleo do WARP (ETAPA 2P-E-A). Estado PENDING_HUMAN_DECISION; nenhuma opcao selecionada; nenhuma autorizacao concedida.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version", "project", "stage", "commit_pinned", "state",
    "references", "source_investigation", "prebuilt_provenance", "options",
    "future_binary_audit_requirements",
    "human_decision_required", "human_decision_received",
    "decision_received", "option_selected",
    "source_path_authorized", "prebuilt_path_authorized",
    "alternative_tool_authorized", "materialization_authorized",
    "build_authorized", "execution_authorized",
    "client_provision_authorized", "client_modification_authorized",
    "first_login_authorized"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "project": { "type": "string", "const": "WARP" },
    "stage": { "type": "string", "const": "2P-E-A" },
    "commit_pinned": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "state": { "type": "string", "const": "PENDING_HUMAN_DECISION" },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "source_investigation": {
      "type": "object",
      "required": ["cpp_qt_source_found_any_branch", "build_recipe_found_any_branch", "source_binary_correspondence"],
      "additionalProperties": true,
      "properties": {
        "cpp_qt_source_found_any_branch": { "type": "boolean" },
        "build_recipe_found_any_branch": { "type": "boolean" },
        "source_binary_correspondence": {
          "type": "string",
          "enum": ["COMPROVADA", "PROVAVEL", "INCONCLUSIVA", "DIVERGENTE", "FONTE NAO LOCALIZADA NO ESCOPO PESQUISADO"]
        }
      }
    },
    "prebuilt_provenance": {
      "type": "object",
      "required": ["official_origin", "custody_chain"],
      "additionalProperties": true,
      "properties": {
        "custody_chain": { "type": "string", "enum": ["FORTE", "MEDIA", "FRACA", "INCONCLUSIVA"] },
        "binary_materialized": { "type": "boolean", "const": false },
        "binary_behavior_analyzed": { "type": "boolean", "const": false }
      }
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "state", "eligible_for_human_consideration", "selected"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "state": { "type": "string", "enum": ["ADEQUADO", "ELEGIVEL_PARA_CONSIDERACAO_EXCEPCIONAL", "INCONCLUSIVO", "INADEQUADO", "NAO DISPONIVEL"] },
          "eligible_for_human_consideration": { "type": "boolean" },
          "selected": { "type": "boolean", "const": false }
        }
      }
    },
    "future_binary_audit_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step", "name", "authorized"],
        "additionalProperties": false,
        "properties": {
          "step": { "type": "integer", "minimum": 1 },
          "name": { "type": "string", "minLength": 1 },
          "authorized": { "type": "boolean", "const": false }
        }
      }
    },
    "human_decision_required": { "type": "boolean", "const": true },
    "human_decision_received": { "type": "boolean", "const": false },
    "decision_received": { "type": "boolean", "const": false },
    "option_selected": { "type": "boolean", "const": false },
    "source_path_authorized": { "type": "boolean", "const": false },
    "prebuilt_path_authorized": { "type": "boolean", "const": false },
    "alternative_tool_authorized": { "type": "boolean", "const": false },
    "stop_path_selected": { "type": "boolean", "const": false },
    "materialization_authorized": { "type": "boolean", "const": false },
    "build_authorized": { "type": "boolean", "const": false },
    "execution_authorized": { "type": "boolean", "const": false },
    "client_provision_authorized": { "type": "boolean", "const": false },
    "client_modification_authorized": { "type": "boolean", "const": false },
    "first_login_authorized": { "type": "boolean", "const": false }
  }
}
