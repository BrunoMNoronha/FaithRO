{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "faithro:warp-audit/core-path-decision-record-real",
  "title": "WARP core-path decision record (real, filled)",
  "description": "Registro REAL de uma decisao humana do caminho do nucleo do WARP (ETAPA 2P-E-A2). Diferente do template em branco, este artefato reproduz uma decisao humana explicita. A selecao registra-se em decision.option; nenhuma flag operacional pode ser true. A selecao de PREBUILT_PATH nao autoriza materializar nem executar o binario.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "project", "stage", "record_type", "note", "status",
    "commit_pinned", "package_ref", "template_ref",
    "decider", "role", "authority", "channel", "date",
    "decision", "justification", "conditions",
    "future_binary_audit_gates", "blocked_patches", "reviewed_only_candidates",
    "authorizations"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "project": { "type": "string", "const": "WARP" },
    "stage": { "type": "string", "const": "2P-E-A2" },
    "record_type": { "type": "string", "const": "human-decision-real" },
    "note": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "const": "DECIDED" },
    "commit_pinned": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "package_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "commit_pinned"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "commit_pinned": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "template_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "must_remain_blank"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "must_remain_blank": { "type": "boolean", "const": true }
      }
    },
    "decider": { "type": "string", "minLength": 2 },
    "role": { "type": "string", "minLength": 2 },
    "authority": { "type": "string", "minLength": 2 },
    "channel": { "type": "string", "minLength": 2 },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["option", "meaning"],
      "properties": {
        "option": {
          "type": "string",
          "enum": ["SOURCE_PATH", "PREBUILT_PATH", "ALTERNATIVE_TOOL", "STOP_PATH"]
        },
        "meaning": { "type": "string", "minLength": 1 }
      }
    },
    "justification": { "type": "string", "minLength": 1 },
    "conditions": {
      "type": "array",
      "minItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["n", "text"],
        "properties": {
          "n": { "type": "integer", "minimum": 1 },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "future_binary_audit_gates": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "blocked_patches": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "reviewed_only_candidates": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "authorizations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human_decision_required", "human_decision_received", "option_selected",
        "source_path_authorized", "prebuilt_path_authorized",
        "alternative_tool_authorized", "stop_path_selected",
        "materialization_authorized", "build_authorized", "execution_authorized",
        "client_provision_authorized", "client_modification_authorized",
        "first_login_authorized"
      ],
      "properties": {
        "human_decision_required": { "type": "boolean", "const": true },
        "human_decision_received": { "type": "boolean", "const": true },
        "option_selected": { "type": "boolean", "const": true },
        "source_path_authorized": { "type": "boolean", "const": false },
        "prebuilt_path_authorized": { "type": "boolean", "const": false },
        "alternative_tool_authorized": { "type": "boolean", "const": false },
        "stop_path_selected": { "type": "boolean", "const": false },
        "materialization_authorized": { "type": "boolean", "const": false },
        "build_authorized": { "type": "boolean", "const": false },
        "execution_authorized": { "type": "boolean", "const": false },
        "client_provision_authorized": { "type": "boolean", "const": false },
        "client_modification_authorized": { "type": "boolean", "const": false },
        "first_login_authorized": { "type": "boolean", "const": false }
      }
    }
  }
}
