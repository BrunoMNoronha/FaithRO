{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "faithro:beam-audit/first-build-authorization-request",
  "title": "Beam Patcher first controlled build human authorization REQUEST (pending, not granted)",
  "description": "Solicitacao formal de autorizacao humana do primeiro build controlado do Beam Patcher (ETAPA 2O-D1-B12). Este artefato apenas SOLICITA a decisao humana; NAO a concede e NAO pode representar uma autorizacao concedida. A decisao pertence a etapa e artefato posteriores.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage",
    "artifact_kind",
    "title",
    "document_reference",
    "runbook_reference",
    "authorization_reference",
    "evidence_reference",
    "request_id",
    "request_status",
    "project",
    "requested_operation",
    "authorization_granted",
    "execution_permitted",
    "authorization_used",
    "authorization_revoked",
    "build_started",
    "beam_downloaded",
    "binary_produced",
    "single_use_required",
    "grant_is_separate_artifact",
    "merge_is_not_authorization",
    "review_is_not_authorization",
    "note",
    "submission",
    "requested_scope",
    "actions_remaining_forbidden",
    "decision_inputs_required",
    "decision_target"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "stage": { "type": "string", "const": "2O-D1-B12" },
    "artifact_kind": { "type": "string", "const": "authorization-request" },
    "title": { "type": "string", "minLength": 1 },
    "document_reference": { "type": "string", "const": "docs/25-solicitacao-autorizacao-primeiro-build-beam.md" },
    "runbook_reference": { "type": "string", "const": "client/patcher/beam-audit/first-build-runbook.example.json" },
    "authorization_reference": { "type": "string", "const": "client/patcher/beam-audit/first-build-authorization.example.json" },
    "evidence_reference": { "type": "string", "const": "client/patcher/beam-audit/first-build-execution-evidence.example.json" },
    "request_id": { "type": "string", "pattern": "^REQ-[0-9A-Za-z-]+$" },
    "request_status": { "type": "string", "const": "PENDING_HUMAN_DECISION" },
    "project": { "type": "string", "const": "FaithRO - Laus Deo" },
    "requested_operation": { "type": "string", "minLength": 1 },
    "authorization_granted": { "type": "boolean", "const": false },
    "execution_permitted": { "type": "boolean", "const": false },
    "authorization_used": { "type": "boolean", "const": false },
    "authorization_revoked": { "type": "boolean", "const": false },
    "build_started": { "type": "boolean", "const": false },
    "beam_downloaded": { "type": "boolean", "const": false },
    "binary_produced": { "type": "boolean", "const": false },
    "single_use_required": { "type": "boolean", "const": true },
    "grant_is_separate_artifact": { "type": "boolean", "const": true },
    "merge_is_not_authorization": { "type": "boolean", "const": true },
    "review_is_not_authorization": { "type": "boolean", "const": true },
    "note": { "type": "string", "minLength": 1 },
    "submission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "faithro_repository",
        "faithro_branch",
        "faithro_reference_commit",
        "runbook_path",
        "runbook_version",
        "runbook_sha256",
        "authorization_template_path",
        "authorization_template_sha256",
        "required_toolchain",
        "preserved_default_toolchain",
        "target",
        "planned_os_environment",
        "default_toolchain_change_forbidden",
        "permanent_path_change_forbidden",
        "override_forbidden"
      ],
      "properties": {
        "faithro_repository": { "type": "string", "const": "BrunoMNoronha/FaithRO" },
        "faithro_branch": { "type": "string", "const": "dev" },
        "faithro_reference_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "runbook_path": { "type": "string", "const": "client/patcher/beam-audit/first-build-runbook.example.json" },
        "runbook_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "runbook_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "authorization_template_path": { "type": "string", "const": "client/patcher/beam-audit/first-build-authorization.example.json" },
        "authorization_template_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "required_toolchain": { "type": "string", "const": "1.85.0-x86_64-pc-windows-msvc" },
        "preserved_default_toolchain": { "type": "string", "const": "1.77.2-x86_64-pc-windows-msvc" },
        "target": { "type": "string", "const": "x86_64-pc-windows-msvc" },
        "planned_os_environment": { "type": "string", "minLength": 1 },
        "default_toolchain_change_forbidden": { "type": "boolean", "const": true },
        "permanent_path_change_forbidden": { "type": "boolean", "const": true },
        "override_forbidden": { "type": "boolean", "const": true }
      }
    },
    "requested_scope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "actions_remaining_forbidden": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "decision_inputs_required": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "decision_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "note", "expiration_required_on_grant", "single_use_required_on_grant"],
      "properties": {
        "artifact": { "type": "string", "const": "client/patcher/beam-audit/first-build-authorization.example.json" },
        "note": { "type": "string", "minLength": 1 },
        "expiration_required_on_grant": { "type": "boolean", "const": true },
        "single_use_required_on_grant": { "type": "boolean", "const": true }
      }
    }
  }
}
