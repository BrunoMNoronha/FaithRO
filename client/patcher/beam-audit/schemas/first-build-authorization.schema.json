{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "faithro:beam-audit/first-build-authorization",
  "title": "Beam Patcher first controlled build human authorization (template, not granted)",
  "description": "Modelo de autorizacao humana do primeiro build controlado do Beam Patcher (ETAPA 2O-D1-B10). Template propositalmente NAO concedido.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage",
    "artifact_kind",
    "title",
    "runbook_reference",
    "evidence_reference",
    "authorization_id",
    "authorization_state",
    "authorization_granted",
    "execution_permitted",
    "authorization_used",
    "authorization_revoked",
    "single_use",
    "required_before_execution",
    "note",
    "binding",
    "validity_window",
    "allowed_scope",
    "forbidden_actions",
    "authorizer",
    "authorization_timestamp_utc",
    "justification",
    "read_risks_confirmed",
    "go_no_go_confirmed",
    "revocation",
    "evidence_binding"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "stage": { "type": "string", "const": "2O-D1-B10" },
    "artifact_kind": { "type": "string", "const": "authorization" },
    "title": { "type": "string", "minLength": 1 },
    "document_reference": { "type": "string", "minLength": 1 },
    "runbook_reference": { "type": "string", "const": "client/patcher/beam-audit/first-build-runbook.example.json" },
    "evidence_reference": { "type": "string", "const": "client/patcher/beam-audit/first-build-execution-evidence.example.json" },
    "authorization_id": { "type": "string", "minLength": 1 },
    "authorization_state": { "type": "string", "const": "template-not-granted" },
    "authorization_granted": { "type": "boolean", "const": false },
    "execution_permitted": { "type": "boolean", "const": false },
    "authorization_used": { "type": "boolean", "const": false },
    "authorization_revoked": { "type": "boolean", "const": false },
    "single_use": { "type": "boolean", "const": true },
    "required_before_execution": { "type": "boolean", "const": true },
    "note": { "type": "string", "minLength": 1 },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "branch",
        "faithro_commit",
        "runbook_version",
        "runbook_sha",
        "upstream_repository",
        "upstream_commit",
        "upstream_tree_digest_algorithm",
        "upstream_tree_digest",
        "overlay_path",
        "overlay_sha256",
        "toolchain",
        "preserved_default_toolchain",
        "target",
        "authorized_host_label"
      ],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "const": "dev" },
        "faithro_commit": { "type": "string", "minLength": 1 },
        "runbook_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "runbook_sha": { "type": "string", "minLength": 1 },
        "upstream_repository": { "type": "string", "const": "beamguides/beam-patcher" },
        "upstream_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "upstream_tree_digest_algorithm": { "type": "string", "const": "sha256" },
        "upstream_tree_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "overlay_path": { "type": "string", "const": "client/patcher/beam-audit/overlays/beam-lab-security.patch" },
        "overlay_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "toolchain": { "type": "string", "const": "1.85.0-x86_64-pc-windows-msvc" },
        "preserved_default_toolchain": { "type": "string", "const": "1.77.2-x86_64-pc-windows-msvc" },
        "target": { "type": "string", "const": "x86_64-pc-windows-msvc" },
        "authorized_host_label": { "type": "string", "minLength": 1 }
      }
    },
    "validity_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["not_before_utc", "not_after_utc", "max_duration_hours", "unlimited_window_forbidden"],
      "properties": {
        "not_before_utc": { "type": "string", "minLength": 1 },
        "not_after_utc": { "type": "string", "minLength": 1 },
        "max_duration_hours": { "type": "integer", "minimum": 1 },
        "unlimited_window_forbidden": { "type": "boolean", "const": true }
      }
    },
    "allowed_scope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "forbidden_actions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "authorizer": { "type": "string", "minLength": 1 },
    "authorization_timestamp_utc": { "type": "string", "minLength": 1 },
    "justification": { "type": "string", "minLength": 1 },
    "read_risks_confirmed": { "type": "boolean", "const": false },
    "go_no_go_confirmed": { "type": "boolean", "const": false },
    "revocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revocable", "revoked", "revoked_reason", "revoked_timestamp_utc"],
      "properties": {
        "revocable": { "type": "boolean", "const": true },
        "revoked": { "type": "boolean", "const": false },
        "revoked_reason": { "type": ["string", "null"] },
        "revoked_timestamp_utc": { "type": ["string", "null"] }
      }
    },
    "evidence_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires_evidence", "evidence_reference", "evidence_completed"],
      "properties": {
        "requires_evidence": { "type": "boolean", "const": true },
        "evidence_reference": { "type": "string", "const": "client/patcher/beam-audit/first-build-execution-evidence.example.json" },
        "evidence_completed": { "type": "boolean", "const": false }
      }
    }
  }
}
