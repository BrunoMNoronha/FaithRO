{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "faithro:beam-audit/first-build-human-presentation-manifest",
  "title": "Beam Patcher first build presentation MANIFEST (not presented, presents nothing)",
  "description": "Manifesto de apresentacao controlada do pacote de decisao (ETAPA 2O-D1-B16). Registra o conteudo, os canais, a autoridade e os procedimentos, em estado NAO apresentado. NAO apresenta, NAO seleciona canal, NAO identifica decisor, NAO registra decisao e NAO concede autorizacao.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage",
    "artifact_kind",
    "title",
    "document_reference",
    "manifest_id",
    "package_id",
    "request_id",
    "project",
    "purpose",
    "presentation_status",
    "presentation_prepared",
    "channel_selected",
    "decision_maker_identified",
    "authority_verified",
    "package_delivered",
    "package_received",
    "decision_requested",
    "decision_received",
    "authorization_granted",
    "execution_permitted",
    "build_started",
    "beam_downloaded",
    "binary_produced",
    "presentation_is_not_decision",
    "receipt_is_not_decision",
    "decision_is_not_authorization",
    "decision_is_not_execution",
    "merge_is_not_presentation",
    "note",
    "faithro_reference_commit",
    "pr_integration",
    "receipt_reference",
    "presented_artifacts",
    "presentation_content",
    "allowed_channel_categories",
    "channel_requirements",
    "authority_requirements",
    "authority_state",
    "pre_presentation_checklist",
    "integrity_procedure",
    "delivery_record_fields",
    "return_procedure",
    "acceptance_criteria",
    "permanently_forbidden",
    "eol_note"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "stage": { "type": "string", "const": "2O-D1-B16" },
    "artifact_kind": { "type": "string", "const": "human-presentation-manifest" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "document_reference": { "type": "string", "const": "docs/27-apresentacao-controlada-pacote-decisao-beam.md" },
    "manifest_id": { "type": "string", "pattern": "^MAN-[0-9A-Za-z-]+$" },
    "package_id": { "type": "string", "pattern": "^PKG-[0-9A-Za-z-]+$" },
    "request_id": { "type": "string", "pattern": "^REQ-[0-9A-Za-z-]+$" },
    "project": { "type": "string", "const": "FaithRO - Laos Deos" },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 900 },
    "presentation_status": { "type": "string", "const": "NOT_PRESENTED" },
    "presentation_prepared": { "type": "boolean", "const": true },
    "channel_selected": { "type": "boolean", "const": false },
    "decision_maker_identified": { "type": "boolean", "const": false },
    "authority_verified": { "type": "boolean", "const": false },
    "package_delivered": { "type": "boolean", "const": false },
    "package_received": { "type": "boolean", "const": false },
    "decision_requested": { "type": "boolean", "const": false },
    "decision_received": { "type": "boolean", "const": false },
    "authorization_granted": { "type": "boolean", "const": false },
    "execution_permitted": { "type": "boolean", "const": false },
    "build_started": { "type": "boolean", "const": false },
    "beam_downloaded": { "type": "boolean", "const": false },
    "binary_produced": { "type": "boolean", "const": false },
    "presentation_is_not_decision": { "type": "boolean", "const": true },
    "receipt_is_not_decision": { "type": "boolean", "const": true },
    "decision_is_not_authorization": { "type": "boolean", "const": true },
    "decision_is_not_execution": { "type": "boolean", "const": true },
    "merge_is_not_presentation": { "type": "boolean", "const": true },
    "note": { "type": "string", "minLength": 1, "maxLength": 1400 },
    "faithro_reference_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "pr_integration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pr_number", "merge_commit", "merge_is_not_presentation"],
      "properties": {
        "pr_number": { "type": "integer", "const": 40 },
        "merge_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "merge_is_not_presentation": { "type": "boolean", "const": true }
      }
    },
    "receipt_reference": { "type": "string", "const": "client/patcher/beam-audit/first-build-human-presentation-receipt.example.json" },
    "presented_artifacts": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "sha256", "eol"],
        "properties": {
          "role": { "type": "string", "enum": ["decision_package", "decision_record", "authorization_request", "runbook", "build_plan", "authorization_template"] },
          "path": { "type": "string", "pattern": "^client/patcher/beam-audit/[A-Za-z0-9._/-]+\\.json$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "eol": { "type": "string", "const": "lf" }
        }
      }
    },
    "presentation_content": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
    "allowed_channel_categories": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
    "channel_requirements": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
    "authority_requirements": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
    "authority_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_maker_identified",
        "identity_confirmed",
        "authority_confirmed",
        "inferred_from_repository_owner_forbidden",
        "inferred_from_github_user_forbidden",
        "lookup_in_contacts_or_email_forbidden"
      ],
      "properties": {
        "decision_maker_identified": { "type": "boolean", "const": false },
        "identity_confirmed": { "type": "boolean", "const": false },
        "authority_confirmed": { "type": "boolean", "const": false },
        "inferred_from_repository_owner_forbidden": { "type": "boolean", "const": true },
        "inferred_from_github_user_forbidden": { "type": "boolean", "const": true },
        "lookup_in_contacts_or_email_forbidden": { "type": "boolean", "const": true }
      }
    },
    "pre_presentation_checklist": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
    "integrity_procedure": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
    "delivery_record_fields": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
    "return_procedure": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
    "acceptance_criteria": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
    "permanently_forbidden": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
    "eol_note": { "type": "string", "minLength": 1, "maxLength": 600 }
  }
}
