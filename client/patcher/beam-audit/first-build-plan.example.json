  "planned_commands": {
    "note": "DADOS NAO EXECUTAVEIS. Nenhum comando abaixo esta autorizado nesta etapa. Copiar comandos isolados nao constitui autorizacao. Placeholders: <TEMP> e o workspace temporario fora do repositorio; <PATCH> e o overlay versionado.",
    "executable_now": false,
    "sequence": [
      {
        "phase": "verify_before",
        "purpose": "Registrar estado da toolchain e do repositorio antes de qualquer acao",
        "command": "rustup show active-toolchain; rustup toolchain list; rustup override list",
        "network": false,
        "authorized_now": false
      },
      {
        "phase": "prepare_source_clone",
        "purpose": "Clonar a origem oficial em workspace temporario externo (sem checkout)",
        "command": "git clone --filter=blob:none --no-checkout https://github.com/beamguides/beam-patcher.git <TEMP>",
        "network": true,
        "authorized_now": false
      },
      {
        "phase": "prepare_source_checkout",
        "purpose": "Fixar o commit auditado em checkout destacado (proibida branch flutuante)",
        "command": "git -C <TEMP> checkout --detach feed97887090d121f796bc1b941390e28b7a2da5",
        "network": false,
        "authorized_now": false
      },
      {
        "phase": "verify_integrity",
        "purpose": "Reconferir a integridade da arvore contra o manifesto versionado",
        "command": "python scripts/audit-beam-upstream.py --source <TEMP> --output <TEMP>/beam-audit.json",
        "network": false,
        "authorized_now": false
      },
      {
        "phase": "apply_overlay",
        "purpose": "Aplicar o overlay de seguranca do laboratorio antes do build",
        "command": "git -C <TEMP> apply --check <PATCH>; git -C <TEMP> apply <PATCH>",
        "network": false,
        "authorized_now": false
      },
      {
        "phase": "validate_overlay",
        "purpose": "Confirmar que o overlay foi aplicado integralmente",
        "command": "python scripts/validate-beam-security-overlay.py --source <TEMP> --patch <PATCH>",
        "network": false,
        "authorized_now": false
      },
      {
        "phase": "generate_lockfile",
        "purpose": "Gerar Cargo.lock no clone temporario, rotulado como GERADO pelo FaithRO",
        "command": "rustup run 1.85.0-x86_64-pc-windows-msvc cargo generate-lockfile",
        "network": true,
        "authorized_now": false
      },
      {
        "phase": "resolve_metadata",
        "purpose": "Resolver o grafo com lock fixo, sem alterar dependencias",
        "command": "rustup run 1.85.0-x86_64-pc-windows-msvc cargo metadata --locked --format-version 1",
        "network": false,
        "authorized_now": false
      },
      {
        "phase": "fetch_dependencies",
        "purpose": "Fase explicita de download das dependencias (rede permitida somente aqui)",
        "command": "rustup run 1.85.0-x86_64-pc-windows-msvc cargo fetch --locked",
        "network": true,
        "authorized_now": false
      },
      {
        "phase": "inventory_dependencies",
        "purpose": "Inventariar o cache de dependencias antes do build",
        "command": "rustup run 1.85.0-x86_64-pc-windows-msvc cargo tree --locked --edges normal",
        "network": false,
        "authorized_now": false
      },
      {
        "phase": "primary_build",
        "purpose": "Primeiro build controlado, com toolchain nomeada, lock fixo e offline",
        "command": "rustup run 1.85.0-x86_64-pc-windows-msvc cargo build --release --locked --offline",
        "network": false,
        "authorized_now": false
      },
      {
        "phase": "inventory_artifacts",
        "purpose": "Inventariar os arquivos produzidos no diretorio de saida temporario",
        "command": "Get-ChildItem -Recurse <TEMP>/target/release",
        "network": false,
        "authorized_now": false
      },
      {
        "phase": "hash_artifacts",
        "purpose": "Registrar SHA-256 dos artefatos sem executar o binario",
        "command": "Get-FileHash -Algorithm SHA256 <TEMP>/target/release/*",
        "network": false,
        "authorized_now": false
      },
      {
        "phase": "second_offline_build",
        "purpose": "Segundo build offline para comparacao (sem prometer bit-for-bit)",
        "command": "rustup run 1.85.0-x86_64-pc-windows-msvc cargo build --release --locked --offline",
        "network": false,
        "authorized_now": false
      },
      {
        "phase": "verify_after",
        "purpose": "Confirmar toolchain padrao preservada e ausencia de override",
        "command": "rustup show active-toolchain; rustup show; rustup override list",
        "network": false,
        "authorized_now": false
      },
      {
        "phase": "cleanup",
        "purpose": "Remover integralmente o workspace temporario",
        "command": "Remove-Item -Recurse -Force <TEMP>",
        "network": false,
        "authorized_now": false
      }
    ],
    "primary_build_command": "rustup run 1.85.0-x86_64-pc-windows-msvc cargo build --release --locked --offline",
